# Puerto del servidor
PORT=3000

# Motor de Inteligencia Artificial (Opcional)
# Si no configuras ninguna API Key, el chatbot funciona 100% GRATIS
# utilizando el motor semántico y de NLP local de alta velocidad.

# Opción 1: OpenAI (GPT-4o-mini / GPT-3.5-turbo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Opción 2: Google Gemini (Gemini 1.5 Flash)
GEMINI_API_KEY=